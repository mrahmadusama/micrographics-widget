<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_mono_mg"
            android:text="@string/setup_title"
            android:textAllCaps="true"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_intro" />
        <Button
            android:id="@+id/btn_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_pin" />

        <Button
            android:id="@+id/btn_pin_gooey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_pin_gooey" />

        <TextView
            android:id="@+id/status_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/geist_mono_mg" />

        <TextView
            android:id="@+id/status_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/geist_mono_mg" />

        <TextView
            android:id="@+id/status_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btn_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_permissions" />

        <Button
            android:id="@+id/btn_locate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_use_location" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/setup_city_hint"
                android:imeOptions="actionDone"
                android:inputType="textCapWords"
                android:singleLine="true" />

            <Button
                android:id="@+id/btn_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_set_city" />
        </LinearLayout>

        <Switch
            android:id="@+id/switch_fahrenheit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_fahrenheit" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_ink" />

        <RadioGroup
            android:id="@+id/ink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/ink_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_ink_auto" />

            <RadioButton
                android:id="@+id/ink_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_ink_light" />

            <RadioButton
                android:id="@+id/ink_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_ink_dark" />

            <RadioButton
                android:id="@+id/ink_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_ink_system" />
        </RadioGroup>

        <Switch
            android:id="@+id/switch_accents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_accents" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_rows" />

        <Switch
            android:id="@+id/show_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_show_weather" />

        <Switch
            android:id="@+id/show_meeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_show_meeting" />

        <Switch
            android:id="@+id/show_birthday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_show_birthday" />

        <Switch
            android:id="@+id/show_alarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_show_alarm" />

        <Switch
            android:id="@+id/show_charging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_show_charging" />

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_refresh" />

        <Button
            android:id="@+id/btn_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_done" />
    </LinearLayout>
</ScrollView>
