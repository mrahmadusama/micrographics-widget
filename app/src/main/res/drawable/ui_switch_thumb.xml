<?xml version="1.0" encoding="utf-8"?>
<!-- Switch thumb: a check on the accent colour when on, a cross on grey when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">
    <item android:drawable="@drawable/ui_switch_thumb_on" android:state_checked="true" />
    <item android:drawable="@drawable/ui_switch_thumb_off" />
</selector>
