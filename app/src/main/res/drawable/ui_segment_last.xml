<?xml version="1.0" encoding="utf-8"?>
<!-- Connected button group segment: squarer inner corners, a full pill once selected. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <selector android:enterFadeDuration="150" android:exitFadeDuration="150">
            <item android:state_checked="true">
                <shape><solid android:color="@color/ui_primary" /><corners android:radius="100dp" /></shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/ui_secondary_container" />
                    <corners android:topLeftRadius="8dp" android:topRightRadius="26dp"
                        android:bottomLeftRadius="8dp" android:bottomRightRadius="26dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
